Windows Registry Editor Version 5.00

; Dev-only template. Prefer tool/register_protocol.ps1 which points at the
; locally built Debug executable. The installer registers HKCU classes.

[HKEY_CURRENT_USER\Software\Classes\moderndownloader]
@="URL:Modern Downloader Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\moderndownloader\DefaultIcon]
@="modern_downloader.exe,0"

[HKEY_CURRENT_USER\Software\Classes\moderndownloader\shell]

[HKEY_CURRENT_USER\Software\Classes\moderndownloader\shell\open]

[HKEY_CURRENT_USER\Software\Classes\moderndownloader\shell\open\command]
@="\"modern_downloader.exe\" \"%1\""
