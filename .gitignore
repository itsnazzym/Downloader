# ═══════════════════════════════════════════════════════════════════════
# Modern Downloader — .gitignore
# Keep source, manifests, and installer scripts tracked.
# Ignore build artifacts, secrets, local data, and AI scratch files.
# ═══════════════════════════════════════════════════════════════════════

# ── OS & System ───────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
Folder.jpg
AlbumArtSmall.jpg
$RECYCLE.BIN/
*.class

